# Copy to .env and fill in your values
# Never commit the real .env file (it's in .gitignore)

# Telegram bot — create via @BotFather, paste the token
TELEGRAM_BOT_TOKEN=

# Your Telegram chat_id (DM your bot, then run main.py once to discover, or use @userinfobot)
TELEGRAM_CHAT_ID=

# Scan settings (defaults shown; override if needed)
FMES_TIMEFRAME=1d
FMES_PIVOT_LEN=7
FMES_SWEEP_WINDOW=20
FMES_REQUIRE_VOL_GAP=true
FMES_REQUIRE_HTF_TREND=true
FMES_REQUIRE_LQ_PLUS=true
FMES_MAX_SETUP_AGE_BARS=10
FMES_HISTORY_BARS=200

# Universe — comma-separated list keys (see fmes/universes.py)
# Options: nifty100, nifty500, fo, us_majors, forex, custom
FMES_UNIVERSES=nifty500

# Supabase (optional — leave blank to disable DB persistence)
# Get these from your Supabase project → Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

